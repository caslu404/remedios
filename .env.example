# Supabase (deixe vazio para usar o modo de demonstração local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push — gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@example.com

# Protege o worker de notificações chamado pelo Supabase Cron
CRON_SECRET=

# Opcional: força demonstração mesmo com Supabase configurado
NEXT_PUBLIC_DEMO_MODE=false
